# ==============================================================================
# Production RAG Pipeline Environment Configuration
# ==============================================================================

# General
APP_NAME="Production RAG Pipeline"
APP_VERSION="0.1.0"
DEBUG=False
LOG_LEVEL="INFO"

# Vector Database (Qdrant)
# Set USE_IN_MEMORY_QDRANT=True for local dev/testing without dependencies.
# Set USE_IN_MEMORY_QDRANT=False and provide QDRANT_URL for remote/docker deployments.
USE_IN_MEMORY_QDRANT=True
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_enterprise_docs

# Embedding Model Configuration
# Options: 'mock' (offline testing) or 'openai' (production)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM Synthesis Configuration
# Options: 'mock' (offline testing) or 'openai' (production)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500

# Chunking Strategy
PARENT_CHUNK_SIZE=800
PARENT_CHUNK_OVERLAP=100
LEAF_CHUNK_SIZE=200
LEAF_CHUNK_OVERLAP=40

# Multi-Stage Retrieval & Re-ranking
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
RRF_K=60
RELEVANCE_THRESHOLD=0.35
RERANKER_PROVIDER=rule_based

# Semantic Caching
SEMANTIC_CACHE_ENABLED=True
SEMANTIC_CACHE_THRESHOLD=0.94
SEMANTIC_CACHE_MAX_ENTRIES=1000

# Guardrails & Verification (Self-RAG)
ENABLE_PII_MASKING=True
ENABLE_SELF_RAG_VERIFICATION=True
MAX_CORRECTION_RETRIES=1

